{
  "schemaVersion": 1,
  "projectName": "Agent Control Center (ACC)",
  "projectType": "existing-control-plane",
  "lifecycle": "IMPLEMENTING",
  "language": "es",
  "structure": "monorepo",
  "repositories": [
    {
      "id": "dashboard",
      "path": ".",
      "remote": "origin"
    }
  ],
  "stack": {
    "backend": "Node.js >=22.18 / TypeScript / NestJS / Express",
    "frontend": "React / Vite / TanStack Router and Query",
    "mobile": null,
    "databases": ["PostgreSQL", "Redis"],
    "integration": ["MCP SDK", "Socket.IO", "OpenAPI 3.1.1"],
    "tooling": ["pnpm", "Turbo", "Docker Compose", "Nginx"]
  },
  "branching": {
    "strategy": "detect-and-propose",
    "defaultDevelopmentBranch": null,
    "productionBranch": null,
    "observedBranchAtMigration": "feat/acc-foundation"
  },
  "agents": {
    "coordinator": "current-session",
    "allowDelegationWithoutPerTaskApproval": false,
    "sharedStateBackend": "files-primary-with-required-acc-mcp-mirror",
    "acc": {
      "enabled": true,
      "required": true,
      "transport": "native-mcp",
      "server": "acc",
      "projectId": "3268b4d2-cd9d-4afc-bc76-ea631997cd73",
      "secretStorage": "outside-version-control",
      "connectionMustBeRechecked": true
    },
    "roleDirectory": "agents/roles",
    "delegationTemplate": "agents/templates/TASK-DELEGATION.md",
    "resultTemplate": "agents/templates/RESULT.md",
    "enabledRoles": [
      "coordinator",
      "requirements-analyst",
      "architect",
      "ux-designer",
      "design-reviewer",
      "developer",
      "qa-engineer",
      "security-reviewer"
    ],
    "independentReviewPreferred": true,
    "runtime": "detect",
    "specialization": {
      "profiles": [],
      "detectOnStartup": true,
      "generateOnAuthorizedSetup": true,
      "catalog": "agents/profiles/catalog.json",
      "generator": "scripts/agents/setup.mjs",
      "roleProfiles": {
        "coordinator": [],
        "requirements-analyst": [],
        "ux-designer": ["react-web"],
        "design-reviewer": ["react-web"],
        "security-reviewer": ["node-nest", "react-web", "postgresql", "mcp-server"],
        "architect": [
          "node-nest",
          "react-web",
          "postgresql",
          "redis-events",
          "mcp-server",
          "docker-local"
        ],
        "developer": [
          "node-general",
          "node-nest",
          "react-web",
          "postgresql",
          "redis-events",
          "mcp-server",
          "docker-local"
        ],
        "qa-engineer": ["node-nest", "react-web", "postgresql", "mcp-server"]
      }
    }
  },
  "permissions": {
    "readOnlyDiscovery": true,
    "editFilesOnTaskRequest": true,
    "installDependencies": false,
    "installSkills": false,
    "gitCommit": false,
    "gitPush": false,
    "gitMerge": false,
    "deploy": false,
    "externalActions": false,
