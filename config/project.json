  "quality": {
    "requireApplicableFullSuite": true,
    "requireRealEvidence": true,
    "uiAlternativesForMaterialNewFlows": 3,
    "projectTaskStates": [
      "BACKLOG",
      "READY",
      "IN_PROGRESS",
      "BLOCKED",
      "IN_REVIEW",
      "IN_QA",
      "DONE",
      "CANCELLED"
    ],
    "humanValidation": "Separate human audit acknowledgement after DONE; no prior human task-state gate",
    "requireRequirementForEveryTask": true,
    "requirementCoverageCheck": "pnpm requirements:check"
  },
  "skills": {
